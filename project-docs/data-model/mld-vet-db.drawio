<mxfile host="app.diagrams.net"><diagram name="MLD" id="mld-vet-db"><mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="VET_SUBSCRIPTION" parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="VET_SUBSCRIPTION" vertex="1"><mxGeometry height="194" width="240" x="0" y="40" as="geometry"/></mxCell><mxCell id="VET_SUBSCRIPTION_a" parent="VET_SUBSCRIPTION" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;html=1;" value="&lt;u&gt;id_subscription&lt;/u&gt;&lt;br&gt;plan_code&lt;br&gt;subscription_status&lt;br&gt;started_at&lt;br&gt;current_period_end&lt;br&gt;canceled_at&lt;br&gt;payment_provider_ref&lt;br&gt;#id_vet_user" vertex="1"><mxGeometry height="168" width="240" y="26" as="geometry"/></mxCell><mxCell id="VET_USER" parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="VET_USER" vertex="1"><mxGeometry height="274" width="240" x="460" y="0" as="geometry"/></mxCell><mxCell id="VET_USER_a" parent="VET_USER" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;html=1;" value="&lt;u&gt;id_vet_user&lt;/u&gt;&lt;br&gt;&lt;i&gt;ordinal_number&lt;/i&gt;&lt;br&gt;email&lt;br&gt;password&lt;br&gt;first_name&lt;br&gt;last_name&lt;br&gt;phone_number&lt;br&gt;payment_customer_ref&lt;br&gt;verification_status&lt;br&gt;verified_at&lt;br&gt;is_available&lt;br&gt;created_at" vertex="1"><mxGeometry height="248" width="240" y="26" as="geometry"/></mxCell><mxCell id="VET_NOTE" parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="VET_NOTE" vertex="1"><mxGeometry height="154" width="240" x="920" y="60" as="geometry"/></mxCell><mxCell id="VET_NOTE_a" parent="VET_NOTE" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;html=1;" value="&lt;u&gt;id_note&lt;/u&gt;&lt;br&gt;&lt;i&gt;id_pet&lt;/i&gt;&lt;br&gt;note_content&lt;br&gt;created_at&lt;br&gt;updated_at&lt;br&gt;#id_vet_user" vertex="1"><mxGeometry height="128" width="240" y="26" as="geometry"/></mxCell><mxCell id="fk_0" edge="1" parent="1" source="VET_SUBSCRIPTION" target="VET_USER" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#666666;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fk_1" edge="1" parent="1" source="VET_NOTE" target="VET_USER" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;strokeColor=#666666;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ZONE" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#666666;" value="App-DB (autre base, lue via l&#x27;API)" vertex="1"><mxGeometry height="150" width="960" x="240" y="340" as="geometry"/></mxCell><mxCell id="VETERINARIAN" parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" value="VETERINARIAN" vertex="1"><mxGeometry height="74" width="240" x="460" y="380" as="geometry"/></mxCell><mxCell id="VETERINARIAN_a" parent="VETERINARIAN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;html=1;" value="&lt;u&gt;ordinal_number&lt;/u&gt;&lt;br&gt;…" vertex="1"><mxGeometry height="48" width="240" y="26" as="geometry"/></mxCell><mxCell id="PET" parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" value="PET" vertex="1"><mxGeometry height="74" width="240" x="920" y="380" as="geometry"/></mxCell><mxCell id="PET_a" parent="PET" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;html=1;" value="&lt;u&gt;id_pet&lt;/u&gt;&lt;br&gt;…" vertex="1"><mxGeometry height="48" width="240" y="26" as="geometry"/></mxCell><mxCell id="x_0" edge="1" parent="1" source="VET_USER" target="VETERINARIAN" style="edgeStyle=none;html=1;rounded=0;endArrow=open;startArrow=none;dashed=1;strokeColor=#999999;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x_0_l" connectable="0" parent="x_0" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#666666;" value="correspondance, sans FK" vertex="1"><mxGeometry relative="1" x="0" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="x_1" edge="1" parent="1" source="VET_NOTE" target="PET" style="edgeStyle=none;html=1;rounded=0;endArrow=open;startArrow=none;dashed=1;strokeColor=#999999;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x_1_l" connectable="0" parent="x_1" style="edgeLabel;html=1;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontSize=11;fontColor=#666666;" value="correspondance, sans FK" vertex="1"><mxGeometry relative="1" x="0" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="LEG" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontStyle=1;fontColor=#333333;" value="Légende — MLD Vet-DB (Merise)" vertex="1"><mxGeometry height="500" width="1280" x="0" y="560" as="geometry"/></mxCell><mxCell id="LEG_t" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;" value="&lt;b&gt;Souligné&lt;/b&gt; = clé primaire · &lt;b&gt;#&lt;/b&gt; = clé étrangère · &lt;b&gt;flèche pleine&lt;/b&gt; = référence (de la clé étrangère vers la table référencée)&lt;br&gt;&lt;i&gt;Italique&lt;/i&gt; + &lt;b&gt;flèche pointillée&lt;/b&gt; = colonne de correspondance avec l&#x27;App-DB : même valeur, sans clé étrangère (deux bases séparées)&lt;br&gt;&lt;b&gt;Vert&lt;/b&gt; = table centrale · &lt;b&gt;Gris pointillé&lt;/b&gt; = table de l&#x27;App-DB, rappelée pour situer les correspondances&lt;br&gt;&lt;br&gt;&lt;b&gt;Passage MCD → MLD&lt;/b&gt; : souscrire et rédiger (côté 1,1) → clé étrangère NOT NULL id_vet_user dans VET_SUBSCRIPTION et VET_NOTE.&lt;br&gt;&lt;br&gt;&lt;b&gt;Schéma relationnel&lt;/b&gt;&lt;br&gt;VET_USER (&lt;u&gt;id_vet_user&lt;/u&gt;, ordinal_number, email, password, first_name, last_name, phone_number, payment_customer_ref, verification_status, verified_at, is_available, created_at)&lt;br&gt;VET_SUBSCRIPTION (&lt;u&gt;id_subscription&lt;/u&gt;, plan_code, subscription_status, started_at, current_period_end, canceled_at, payment_provider_ref, #id_vet_user)&lt;br&gt;VET_NOTE (&lt;u&gt;id_note&lt;/u&gt;, id_pet, note_content, created_at, updated_at, #id_vet_user)&lt;br&gt;&lt;br&gt;&lt;b&gt;Contraintes à poser au MPD&lt;/b&gt;&lt;br&gt;• UNIQUE : VET_USER.ordinal_number · VET_USER.email · VET_USER.payment_customer_ref · VET_SUBSCRIPTION.payment_provider_ref&lt;br&gt;• CHECK : verification_status (pending, verified, rejected) · subscription_status (active, unpaid, canceled) · is_available = false si le compte n&#x27;est pas vérifié&lt;br&gt;• index partiel UNIQUE : un seul VET_SUBSCRIPTION actif par id_vet_user (RGV5)&lt;br&gt;• index sur VET_NOTE (id_pet, id_vet_user) : notes d&#x27;un animal pour un véto&lt;br&gt;&lt;br&gt;&lt;b&gt;Périmètre&lt;/b&gt; : la Vet-DB contient les comptes du Portail. Restent dans l&#x27;App-DB : l&#x27;annuaire VETERINARIAN (partenaires ou non), CLINIC et exercer, PET, PET_VET_ACCESS, CONVERSATION / MESSAGE / ESCALATION, HEALTH_ENTRY / DOCUMENT. Le Portail les lit et les écrit via l&#x27;API de l&#x27;App-DB.&lt;br&gt;&lt;b&gt;Correspondances, sans clé étrangère entre les bases&lt;/b&gt; : VET_USER.ordinal_number = VETERINARIAN.ordinal_number (RG37) · VET_NOTE.id_pet = PET.id_pet&lt;br&gt;&lt;br&gt;&lt;b&gt;Règles de gestion (RGV = Vet-DB, RGxx = doc MCD App-DB)&lt;/b&gt;&lt;br&gt;• RGV1 : ordinal_number et email sont uniques ; ordinal_number est immuable.&lt;br&gt;• RGV2 : verification_status vaut en attente, vérifié ou refusé. La vérification contrôle le numéro et le nom dans l&#x27;annuaire de l&#x27;Ordre. Seul un compte vérifié accède aux données et peut se déclarer disponible.&lt;br&gt;• RGV3 : la vérification puis chaque modification du profil créent ou mettent à jour l&#x27;occurrence de l&#x27;annuaire App-DB et la passent partenaire (RG38 étendue). Pour un partenaire, le Portail fait foi.&lt;br&gt;• RGV4 : seul un véto vérifié et disponible (is_available) peut recevoir une escalade (RG56).&lt;br&gt;• RGV5 : un véto a au plus un abonnement actif ; les anciens restent historisés. Statuts : actif, impayé, résilié, mis à jour par les webhooks Stripe.&lt;br&gt;• RGV6 : une note est privée, visible de son seul auteur. Le commentaire destiné au propriétaire va dans l&#x27;App-DB (HEALTH_ENTRY ou DOCUMENT, source véto : RG68, RG72).&lt;br&gt;• RGV7 : un véto ne crée une note sur un animal que s&#x27;il a un accès actif à cet animal (PET_VET_ACCESS, vérifié via l&#x27;API).&lt;br&gt;• RGV8 : la suppression d&#x27;un animal dans l&#x27;App-DB supprime ses notes (événement applicatif, pas de cascade entre les bases)." vertex="1"><mxGeometry height="456" width="1250" x="14" y="594" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>