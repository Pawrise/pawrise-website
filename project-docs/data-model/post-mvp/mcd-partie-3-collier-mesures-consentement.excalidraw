  {
   "id": "lecture",
   "type": "rectangle",
   "x": 1900,
   "y": 0,
   "width": 560,
   "height": 310.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#f8f9fa",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "dashed",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
